{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": ["scripts/*.mjs"]
		},
		"packages/core": {},
		"packages/agents": {
			"ignoreDependencies": ["@dawnskill/core", "typebox"]
		},
