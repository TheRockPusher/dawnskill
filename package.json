{
	"name": "dawnskill",
	"version": "0.0.0",
	"private": true,
	"license": "AGPL-3.0-only",
	"description": "Learning-first agentic task manager",
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"format": "biome format --write .",
		"format:check": "biome format .",
		"typecheck": "tsc -b",
		"triggers:gen": "node scripts/gen-triggers.ts",
		"triggers:check": "node scripts/gen-triggers.ts --check",
		"lint": "oxlint --type-aware",
		"knip": "knip",
		"test": "TZ=UTC vitest run",
		"build": "pnpm --filter @dawnskill/web build",
		"check": "pnpm format:check && pnpm typecheck && pnpm triggers:check && pnpm lint && pnpm knip && pnpm test && pnpm build",
		"perf": "node scripts/perf.ts",
		"start": "node packages/host/src/main.ts",
		"dev": "pnpm run \"/^dev:/\"",
		"dev:host": "node --watch packages/host/src/main.ts",
		"dev:web": "pnpm --filter @dawnskill/web dev",
		"mutation": "stryker run"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@fast-check/vitest": "0.5.0",
		"@stryker-mutator/core": "10.0.0",
		"@stryker-mutator/vitest-runner": "10.0.0",
		"@types/node": "24.19.2",
		"fast-check": "4.10.2",
		"knip": "6.41.0",
		"lefthook": "2.2.2",
		"oxlint": "1.88.0",
		"oxlint-tsgolint": "7.0.2004",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	}
}
